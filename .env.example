# Copie este arquivo para ".env" e preencha os valores.
# O .env NAO deve ser commitado (ja esta no .gitignore).

# Conexao com o PostgreSQL (ex.: Neon). Use a versao "pooled" para serverless.
# O "uselibpqcompat=true" evita um aviso de depreciacao do driver pg.
DATABASE_URL="postgresql://USUARIO:SENHA@HOST-pooler.REGIAO.aws.neon.tech/NOME_DB?sslmode=require&channel_binding=require&uselibpqcompat=true"

# Segredo do Auth.js para assinar as sessoes. Gere um com: npx auth secret
AUTH_SECRET=""

# Necessario em producao (ex.: Vercel) para o Auth.js confiar no host.
AUTH_TRUST_HOST="true"

# Usados apenas pelo script de seed (npm run seed) para criar o usuario inicial.
SEED_NAME="Nome do Usuario"
SEED_EMAIL="usuario@exemplo.com"
SEED_PASSWORD="uma-senha-forte"
